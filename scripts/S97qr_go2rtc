#!/bin/sh
# Hardware H.264 (rkipc) -> WebRTC (go2rtc) for the QR application.
# This intentionally uses ports different from the firmware-managed go2rtc.

APP_DIR=/userdata/qr_rec
CONFIG="$APP_DIR/go2rtc.yaml"
PID=/var/run/qr_go2rtc.pid
LOG="$APP_DIR/qr_go2rtc.log"

find_go2rtc() {
    if command -v go2rtc >/dev/null 2>&1; then
        command -v go2rtc
    elif [ -x /usr/bin/go2rtc ]; then
        printf '%s\n' /usr/bin/go2rtc
    elif [ -x /oem/usr/bin/go2rtc ]; then
        printf '%s\n' /oem/usr/bin/go2rtc
    fi
}

start() {
    BIN=$(find_go2rtc)
    [ -n "$BIN" ] && [ -r "$CONFIG" ] || exit 1
    start-stop-daemon -S -o -b -m -p "$PID" -x "$BIN" -- \
        -config "$CONFIG" >>"$LOG" 2>&1
}

stop() {
    start-stop-daemon -K -o -p "$PID" 2>/dev/null || true
    rm -f "$PID"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
